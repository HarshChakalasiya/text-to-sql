# Core
DATABASE_URL=postgresql+psycopg://scf:scf@localhost:5433/scf
LLM_PROVIDER=openai

# OpenAI-compatible (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama (used when LLM_PROVIDER=ollama)
# Install Ollama locally, then: ollama pull llama3.2 && ollama pull nomic-embed-text
# Also used for embeddings when LLM_PROVIDER=claude (Anthropic has no embedding API)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Claude (used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5

# App
SQL_QUERY_TIMEOUT_SECONDS=10
HYBRID_TOP_K=5
# Document embeddings: pgvector (Postgres) or memory (in-process only, e.g. SQLite tests)
VECTOR_STORE=pgvector